<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram id="m3-architecture" name="M3 Multi-Agent Architecture">
    <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;CourseGuide AI — Milestone 3 Architecture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Sequential multi-agent tutoring system (OpenAI Agents SDK + MCP over stdio)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="30" y="5" width="900" height="55" as="geometry" />
        </mxCell>

        <!-- Model backend -->
        <mxCell id="model" value="&lt;b&gt;MODEL BACKEND (BYOM / NRP)&lt;/b&gt;&lt;br&gt;AsyncOpenAI client → MODEL_BASE_URL / NRP_BASE_URL · default model &lt;i&gt;gpt-oss&lt;/i&gt; · chat_completions API&lt;br&gt;Both agents share one model (MODEL_NAME or --model)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="70" width="780" height="65" as="geometry" />
        </mxCell>

        <!-- Student input -->
        <mxCell id="input" value="&lt;b&gt;USER INPUT&lt;/b&gt;&lt;br&gt;Student question + course_id&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Problem: students get stuck on graded coursework and need guidance, not the answer&lt;br&gt;CLI: python -m src.m3_agent --course --question&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="190" width="200" height="150" as="geometry" />
        </mxCell>

        <!-- Input guardrails -->
        <mxCell id="gr_in" value="&lt;b&gt;INPUT GUARDRAILS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;• configure_client() raises if base URL / API key unset&lt;br&gt;• Unknown course_id → DEFAULT_POLICY fallback&lt;br&gt;• remember() rejects empty notes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;align=left;spacingLeft=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="390" width="200" height="130" as="geometry" />
        </mxCell>

        <!-- Runtime container -->
        <mxCell id="runtime" value="&lt;b&gt;Python process — src/m3_agent.py &lt;i&gt;ask()&lt;/i&gt; · OpenAI Agents SDK &lt;i&gt;Runner.run()&lt;/i&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="260" y="150" width="840" height="580" as="geometry" />
        </mxCell>

        <!-- Agent 1: Planner -->
        <mxCell id="planner" value="&lt;b&gt;AGENT 1 — CourseGuidePlanner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Role: classify + gather evidence&lt;br&gt;Persona: first agent in a sequential tutoring system&lt;br&gt;Never answers the student directly&lt;br&gt;MCP servers: Policy + Memory&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="190" width="260" height="190" as="geometry" />
        </mxCell>
        <mxCell id="reasoning" value="&lt;b&gt;REASONING: sequential reasoning&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;request type → policy constraints → knowns / unknowns → exactly ONE next step (in planner prompt)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="295" width="240" height="75" as="geometry" />
        </mxCell>

        <!-- Handoff -->
        <mxCell id="handoff" value="&lt;b&gt;EXPLICIT HANDOFF&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Trigger:&lt;/b&gt; planner Runner.run() completes&lt;br&gt;&lt;b&gt;Payload:&lt;/b&gt; planning_result.final_output (text) + course_id + question&lt;br&gt;REQUEST_TYPE · POLICY_CONSTRAINTS · STUDENT_CONTEXT · NEXT_STEP · MEMORY_TO_SAVE&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;size=0.08;" vertex="1" parent="1">
          <mxGeometry x="580" y="205" width="220" height="150" as="geometry" />
        </mxCell>

        <!-- Agent 2: Tutor -->
        <mxCell id="tutor" value="&lt;b&gt;AGENT 2 — CourseGuideTutor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Role: apply policy, write student-facing reply&lt;br&gt;Persona: handoff is authoritative context, not a final answer&lt;br&gt;Asks what the student tried; one step at a time&lt;br&gt;MCP servers: Policy + Memory&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="830" y="190" width="240" height="190" as="geometry" />
        </mxCell>
        <mxCell id="gr_out_inline" value="&lt;b&gt;OUTPUT GUARDRAIL (prompt)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;No full solution / final numeric answer unless policy allows; no internal headings exposed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="295" width="220" height="75" as="geometry" />
        </mxCell>

        <!-- Policy MCP server -->
        <mxCell id="policy" value="&lt;b&gt;MCP: CoursePolicyServer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;mcp_servers/course_policy_mcp.py (stdio)&lt;br&gt;• classify_help_request — rule-based help type&lt;br&gt;• lookup_course_policy — instructor policy text&lt;br&gt;• list_available_courses&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="500" width="260" height="125" as="geometry" />
        </mxCell>
        <mxCell id="policy_db" value="&lt;font style=&quot;font-size:11px&quot;&gt;config/*.yaml&lt;br&gt;(physics_101, chemistry_201, biology_201)&lt;br&gt;allowed / forbidden help levels, tone, style rules&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="290" y="645" width="260" height="70" as="geometry" />
        </mxCell>

        <!-- Memory MCP server -->
        <mxCell id="memory" value="&lt;b&gt;KNOWLEDGE / MEMORY LAYER&lt;/b&gt;&lt;br&gt;&lt;b&gt;MCP: AgentMemoryServer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;mcp_servers/memory_mcp.py (stdio)&lt;br&gt;• recall(course_id, query) — last 5 matching notes&lt;br&gt;• remember(course_id, student_note)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="810" y="500" width="260" height="125" as="geometry" />
        </mxCell>
        <mxCell id="memory_db" value="&lt;font style=&quot;font-size:11px&quot;&gt;data/agent_memory.json&lt;br&gt;persistent notes · capped at latest 100&lt;br&gt;substring match (no vector DB yet)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="810" y="645" width="260" height="70" as="geometry" />
        </mxCell>

        <!-- Output -->
        <mxCell id="output" value="&lt;b&gt;AGENT OUTPUT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Student-facing reply: smallest useful next step, guiding question, units / conventions — addresses the &quot;stuck&quot; problem without giving the answer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1150" y="190" width="230" height="150" as="geometry" />
        </mxCell>

        <!-- Output guardrails (policy) -->
        <mxCell id="gr_out" value="&lt;b&gt;OUTPUT GUARDRAILS (policy)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;• forbidden_help_levels: full_solution, direct_answer&lt;br&gt;• style_rules from course YAML&lt;br&gt;• Memory capped at 100 notes&lt;br&gt;&lt;i&gt;Gap: handoff text is not schema-validated&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;align=left;spacingLeft=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1150" y="390" width="230" height="130" as="geometry" />
        </mxCell>

        <!-- Tracing -->
        <mxCell id="tracing" value="&lt;b&gt;Tracing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ConsoleTracingProcessor logs spans, tool calls, token usage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1150" y="560" width="230" height="70" as="geometry" />
        </mxCell>

        <!-- Evaluation harness -->
        <mxCell id="eval_label" value="&lt;b&gt;EVALUATION HARNESS (offline of the runtime, drives ask())&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="765" width="500" height="25" as="geometry" />
        </mxCell>
        <mxCell id="eval_cases" value="&lt;b&gt;tests/m3_evaluation_cases.yaml&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;10 cases: input, course_id, expected keywords&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="800" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="eval_run" value="&lt;b&gt;scripts/evaluate_m3.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Keyword match → PASS / FAIL&lt;br&gt;Failure category: response_keyword | execution&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="570" y="800" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="eval_out" value="&lt;b&gt;evaluation_results.csv&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Overall pass rate vs. success threshold&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;size=14;" vertex="1" parent="1">
          <mxGeometry x="900" y="800" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Solid arrow = data / control flow&lt;br&gt;Dashed arrow = tool call (MCP) or support link&lt;br&gt;Red dashed = guardrail · Green = memory layer&lt;br&gt;Orange = reasoning pattern&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1150" y="660" width="230" height="110" as="geometry" />
        </mxCell>

        <!-- ===== Edges ===== -->
        <mxCell id="e_in_planner" value="1. course_id + question" style="endArrow=classic;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="input" target="planner">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_gr_in" value="" style="endArrow=classic;html=1;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="gr_in" target="input">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_planner_handoff" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="planner" target="handoff">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_handoff_tutor" value="2. handoff" style="endArrow=classic;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="handoff" target="tutor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_tutor_out" value="3. final_output" style="endArrow=classic;html=1;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="tutor" target="output">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_planner_policy" value="classify_help_request,&#xa;lookup_course_policy" style="endArrow=classic;startArrow=classic;html=1;dashed=1;fontSize=11;" edge="1" parent="1" source="planner" target="policy">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="420" y="440" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_planner_memory" value="recall (prior notes)" style="endArrow=classic;startArrow=classic;html=1;dashed=1;fontSize=11;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="planner" target="memory">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_tutor_memory" value="remember (MEMORY_TO_SAVE)" style="endArrow=classic;html=1;dashed=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tutor" target="memory">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_policy_db" value="load_policy()" style="endArrow=classic;html=1;fontSize=11;" edge="1" parent="1" source="policy" target="policy_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_memory_db" value="read / write JSON" style="endArrow=classic;startArrow=classic;html=1;fontSize=11;" edge="1" parent="1" source="memory" target="memory_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_model_planner" value="chat completions" style="endArrow=classic;startArrow=classic;html=1;dashed=1;fontSize=11;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="model" target="planner">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_model_tutor" value="chat completions" style="endArrow=classic;startArrow=classic;html=1;dashed=1;fontSize=11;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="model" target="tutor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_gr_out" value="" style="endArrow=classic;html=1;dashed=1;strokeColor=#b85450;exitX=0;exitY=0.25;exitDx=0;exitDy=0;" edge="1" parent="1" source="gr_out" target="runtime">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_trace" value="" style="endArrow=classic;html=1;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="tracing" target="runtime">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_cases_run" value="" style="endArrow=classic;html=1;" edge="1" parent="1" source="eval_cases" target="eval_run">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_run_out" value="" style="endArrow=classic;html=1;" edge="1" parent="1" source="eval_run" target="eval_out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_run_ask" value="ask(course, question)" style="endArrow=classic;html=1;dashed=1;fontSize=11;" edge="1" parent="1" source="eval_run" target="runtime">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
